__pycache__/
*.py[cod]
*$py.class

# Virtual environment
.venv/
venv/
ENV/
env/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# OS-generated files
.DS_Store
Thumbs.db

# IDE settings
.vscode/
.idea/

# Python packaging
*.egg-info/
build/
dist/

